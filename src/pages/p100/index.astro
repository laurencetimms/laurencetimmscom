---
import Mode7Layout from '../../layouts/Mode7Layout.astro';
import { getProjects, STATUS_LABEL, leader } from '../../lib/projects';
import { ago } from '../../lib/github';

const projects = await getProjects();
const games = projects.filter((p) => p.entry.data.page < 400);
const tools = projects.filter((p) => p.entry.data.page >= 400);
const groups = [
  { id: 'games', label: 'GAMES', items: games },
  { id: 'tools', label: 'TOOLS', items: tools },
];
---
<Mode7Layout
  title="Workshop (P100)"
  path="/p100/"
  pageNo="P100"
  heading="WORKSHOP"
  glitchHeading
  description="Things Laurence Timms builds with Claude: games, tools and experiments, each with a teletext page number."
>
  <p class="m7-intro"><span class="gl" data-glitch="black">Things I build with Claude: games, tools, experiments. Updated overnight from GitHub.</span></p>

  <div class="m7-cols">
    <div class="m7-index">
      {groups.map((g) => g.items.length > 0 && (
        <section id={g.id} aria-labelledby={`${g.id}-h`}>
          <h2 id={`${g.id}-h`}>{g.label}</h2>
          <ul class="m7-list">
            {g.items.map(({ entry: p, touched }) => {
              const name = p.data.title.toUpperCase();
              return (
                <li>
                  <a class="m7-row" href={`/p100/${p.id}/`}>
                    <span class="pg">{p.data.page}</span>
                    <span class="txt">
                      <span class="nm gl" data-glitch="black">{name}</span><span aria-hidden="true">{leader(name, p.data.kind)}</span><span class="gl" data-glitch="black">{p.data.kind}</span>
                    </span>
                    <span class={`st st-${p.data.status}`}>{STATUS_LABEL[p.data.status]}</span>
                    {(touched.last || touched.behind) && (
                      <span class="tch">
                        {touched.last && <time datetime={touched.last.toISOString()}>{ago(touched.last)}</time>}
                        {touched.behind && <span class="flag-behind">COPY BEHIND SOURCE</span>}
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <section class="mines" id="p888" aria-labelledby="mines-h" hidden>
      <div class="mines-head">
        <h2 class="mines-title" id="mines-h">P888 MINES</h2>
        <span id="mines-msg" aria-live="polite">CLICK A SQUARE</span>
      </div>
      <div class="mines-grid" id="mines-grid" role="group" aria-label="Minefield, 8 by 8. Arrow keys move between squares."></div>
      <div class="mines-actions">
        <button type="button" class="mines-btn mines-new" id="mines-new">NEW</button>
        <button type="button" class="mines-btn mines-flag" id="mines-flag" aria-pressed="false">FLAG<span aria-hidden="true" id="mines-flag-state">: OFF</span></button>
      </div>
    </section>
  </div>

  <script>
    import '../../scripts/glitch';
    import '../../scripts/mines';
  </script>
</Mode7Layout>
