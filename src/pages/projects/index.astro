---
import Layout from '../../layouts/Layout.astro';

const projects = [
  { href: '/loadedzone/', name: 'LoadedZone', desc: 'A zone 2 rucking site with a Pandolf-equation load calculator.' },
  { href: '/walk/', name: 'Walk', desc: 'A contemplative walking app built on generative audio and anti-engagement design.' },
];
---
<Layout
  title="Projects"
  path="/projects/"
  description="LoadedZone and Walk."
>
  <p class="eyebrow">Projects</p>
  <h1>Things I've built</h1>
  <div class="prose">
    <p>
      Personal projects that I want to share. I'm an inveterate tinkerer and
      life-long programmer, and occasionally I create something useful.
    </p>
  </div>
  <div class="card-grid">
    {projects.map((p) => (
      <a class="card" href={p.href}>
        <h3>{p.name}</h3>
        <p>{p.desc}</p>
      </a>
    ))}
  </div>
</Layout>
