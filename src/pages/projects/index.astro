---
import Layout from '../../layouts/Layout.astro';

const projects = [
  { href: '/loadedzone/', name: 'LoadedZone', desc: 'A zone 2 rucking site with a Pandolf-equation load calculator.' },
  { href: '/walk/', name: 'Walk', desc: 'A contemplative walking app built on generative audio and anti-engagement design.' },
  { href: '/lab/', name: 'Lab', desc: 'Smaller game and software projects — SHIPSHAP.EXE, The Barrow.' },
];
---
<Layout
  title="Projects"
  path="/projects/"
  description="LoadedZone, Walk, and smaller software and game projects."
>
  <p class="eyebrow">Projects</p>
  <h1>Things I've built</h1>
  <div class="prose">
    <p>
      Software built outside the coaching work — some useful, some purely for
      their own sake. Kept here rather than folded into the professional
      material, because they're evidence of range rather than part of the offer.
    </p>
  </div>
  <div class="card-grid">
    {projects.map((p) => (
      <a class="card" href={p.href}>
        <h3>{p.name}</h3>
        <p>{p.desc}</p>
      </a>
    ))}
  </div>
</Layout>
