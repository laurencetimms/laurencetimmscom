---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CLAUS',
  description: 'CLAUS is an experimental team dynamics tool for team leaders and team coaches, built on Claude.',
  url: 'https://claus.laurencetimms.com',
  applicationCategory: 'BusinessApplication',
  author: {
    '@type': 'Person',
    name: 'Laurence Timms',
    url: 'https://laurencetimms.com',
  },
};
---
<Layout
  title="CLAUS"
  path="/claus/"
  description="CLAUS is an experimental team dynamics tool for team leaders and team coaches, built on Claude."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <span class="subbrand-badge">Project</span>
  <h1>CLAUS</h1>
  <div class="prose">
    <p>
      CLAUS is an experimental team dynamics tool for team leaders and team
      coaches, built on Claude. It augments the professional judgement that a
      leader or coach brings to a team, rather than attempting to replace it.
    </p>
    <p>
      It's live at <a href="https://claus.laurencetimms.com"><strong>claus.laurencetimms.com</strong></a>, including a demo scenario showing a fictional team navigating real dysfunction.
    </p>
    <p>
      If you'd like to hear more about CLAUS or arrange a demo, please <a href="/coaching/#contact">contact me</a>.
    </p>
    <p>Source: <a href="https://github.com/laurencetimms/claus">github.com/laurencetimms/claus</a></p>
  </div>
</Layout>
