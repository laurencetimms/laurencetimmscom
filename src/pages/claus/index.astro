---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CLAUS',
  description: 'CLAUS is an AI-augmented team dynamics tool for team leaders and team coaches.',
  url: 'https://claus.laurencetimms.com',
  applicationCategory: 'BusinessApplication',
  author: {
    '@type': 'Person',
    name: 'Laurence Timms',
    url: 'https://laurencetimms.com',
  },
};
---
<Layout
  title="CLAUS"
  path="/claus/"
  description="CLAUS is an AI-augmented team dynamics tool for team leaders and team coaches."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <span class="subbrand-badge">Project</span>
  <h1>CLAUS</h1>
  <div class="prose">
    <p>
      CLAUS is a team dynamics tool for team leaders and team coaches, built
      on Claude — augmenting the judgement a leader or coach brings to a
      team, not replacing it.
    </p>
    <p>
      It's live at <a href="https://claus.laurencetimms.com"><strong>claus.laurencetimms.com</strong></a> — not just a page about the idea, but the running application.
    </p>
    <p>
      It includes "The Demo" — a scenario showing a fictional team, Team
      Jupiter, navigating real dysfunction, as a way of trying CLAUS in
      action rather than just reading about it.
    </p>
    <p>Source: <a href="https://github.com/laurencetimms/claus">github.com/laurencetimms/claus</a></p>
  </div>
</Layout>
