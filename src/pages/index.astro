---
import Layout from '../layouts/Layout.astro';

const sections = [
  { href: '/writing/', title: 'Writing', desc: 'Frameworks, essays, and models drawn from live organisational work.' },
  { href: '/coaching/', title: 'Coaching', desc: 'Executive and organisational coaching — approach, and how to work with me.' },
  { href: '/claus/', title: 'CLAUS', desc: 'An AI-augmented team dynamics tool for team leaders and team coaches.' },
  { href: '/projects/', title: 'Projects', desc: 'LoadedZone and Walk.' },
];
---

<Layout
  title="Home"
  path="/"
  description="Laurence Timms — coach working with leaders and teams through organisational change, software delivery improvement, and AI-augmented coaching practice."
>
  <h1>Unlock your potential</h1>
  <div class="intro-with-portrait intro-with-portrait--small">
    <img
      class="portrait portrait--small"
      src="/images/laurence-timms-400.webp"
      width="130"
      height="130"
      alt="Laurence Timms"
      loading="eager"
    />
    <div class="prose">
      <p>
        I'm a coach. I work with people who want to take charge of the changes
        in their lives and help them to reveal their goals and identify the
        actions they can take to achieve them.
      </p>
      <p>
        I have over forty years' experience across private, public, and
        charity sectors, in both mature organisations and startups. If I have
        learned one thing, it is that the better we understand our goals, the
        more motivated we are to pursue them.
      </p>
    </div>
  </div>

  <div class="card-grid">
    {sections.map((s) => (
      <a class="card" href={s.href}>
        <h3>{s.title}</h3>
        <p>{s.desc}</p>
      </a>
    ))}
  </div>
</Layout>
