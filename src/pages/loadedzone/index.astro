---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="LoadedZone"
  path="/loadedzone/"
  description="LoadedZone — a zone 2 rucking site with a Pandolf-equation load calculator."
>
  <span class="subbrand-badge">Sub-brand</span>
  <h1>LoadedZone</h1>
  <div class="prose">
    <p>
      A site for zone 2 rucking, built around a calculator using the Pandolf
      equation to estimate metabolic load from pack weight, pace, and
      terrain.
    </p>
    <p>The calculator will be ported in as a client-side tool at this path — no server calls required to use it.</p>
  </div>
</Layout>
