---
import Layout from '../../layouts/Layout.astro';

// Nested under the site-wide Person (same identity as Layout.astro's
// schema-wide block) rather than freestanding, per schema.org convention —
// and pointed at the coaching page rather than publishing a raw inbox
// address, since the form is the intended channel.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Laurence Timms',
  url: 'https://laurencetimms.com',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Coaching enquiries',
    url: 'https://laurencetimms.com/coaching/',
    availableLanguage: 'English',
  },
};
---
<Layout
  title="Coaching"
  path="/coaching/"
  description="Executive and organisational coaching for technology and delivery leaders."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <p class="eyebrow">Coaching</p>
  <h1>Working with me</h1>
  <div class="prose">
    <p>
      I coach individuals and teams inside technology and delivery
      organisations — people navigating change, growth, or the gap between
      how their organisation works today and how it needs to work next.
    </p>
    <p>
      My approach draws on organisational psychology and systems thinking as
      much as on coaching technique, and is grounded in real delivery work,
      not theory alone.
    </p>
  </div>

  <section class="contact">
    <h2>Get in touch</h2>
    <p class="prose">Tell me a bit about what you're working on, and I'll reply by email.</p>

    <form class="contact-form" id="contact-form" novalidate>
      <div class="field">
        <label for="contact-name">Name</label>
        <input type="text" id="contact-name" name="name" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="contact-email">Email</label>
        <input type="email" id="contact-email" name="email" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" rows="6" required></textarea>
      </div>

      <div class="field hp-field" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="cf-turnstile" data-sitekey="0x4AAAAAAEbe4DMS05estZy0" data-theme="light"></div>

      <button type="submit" class="contact-submit" id="contact-submit">Send message</button>

      <p class="form-status" id="contact-status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('contact-status') as HTMLParagraphElement;
    const submitButton = document.getElementById('contact-submit') as HTMLButtonElement;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      status.textContent = '';
      status.classList.remove('form-status--success', 'form-status--error');

      const data = new FormData(form);
      const payload = {
        name: data.get('name'),
        email: data.get('email'),
        message: data.get('message'),
        website: data.get('website'),
        token: data.get('cf-turnstile-response'),
      };

      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));

        if (response.ok && result.ok) {
          status.textContent = "Thanks — your message is on its way. I'll reply by email.";
          status.classList.add('form-status--success');
          form.reset();
        } else {
          status.textContent = result.error || 'Something went wrong. Please try again.';
          status.classList.add('form-status--error');
        }
      } catch {
        status.textContent = 'Something went wrong sending your message. Check your connection and try again.';
        status.classList.add('form-status--error');
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Send message';
        // Turnstile tokens are single-use — reset so a retry (or a second
        // enquiry) gets a fresh one, whether this attempt succeeded or not.
        window.turnstile?.reset();
      }
    });
  </script>
</Layout>
