---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Walk"
  path="/walk/"
  description="Walk — a contemplative walking app for Android, built on generative audio and anti-engagement design."
>
  <span class="subbrand-badge">Sub-brand</span>
  <h1>Walk</h1>
  <div class="prose">
    <p>
      Walk is an Android app for contemplative walking, built around
      generative audio rather than tracked routes or streaks. It's designed
      deliberately against the engagement-maximising patterns most apps use.
    </p>
    <p>This page will carry the design rationale and a link to the app once it's out of closed testing.</p>
  </div>
</Layout>
