---
import Layout from '../../layouts/Layout.astro';

const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=com.walk.app';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Walk',
  description:
    'Walk is an Android app that supports creative thinking through sound, gentle movement, and minimal distraction.',
  url: PLAY_STORE_URL,
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Android',
  author: {
    '@type': 'Person',
    name: 'Laurence Timms',
    url: 'https://laurencetimms.com',
  },
};

const research = [
  {
    name: 'Default Mode Network research (Marcus Raichle)',
    note: 'the brain network active during rest and mind-wandering — the kind of unstructured thinking a focused task switches off.',
  },
  {
    name: 'Focused and diffuse thinking (Barbara Oakley)',
    note: 'insight often needs an unfocused mode to work in, not sustained concentration.',
  },
  {
    name: 'Unconscious thought theory (Ap Dijksterhuis)',
    note: 'complex problems can be worked on better without conscious attention on them.',
  },
  {
    name: 'Stanford research on walking and creativity',
    note: 'walking measurably increases creative output compared to sitting, during the walk and shortly after.',
  },
  {
    name: 'Attention Restoration Theory (Kaplan & Kaplan)',
    note: 'certain environments restore depleted directed attention rather than demanding more of it.',
  },
];
---
<Layout
  title="Walk"
  path="/walk/"
  description="Walk — an Android app that supports creative thinking through sound, gentle movement, and minimal distraction."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <span class="subbrand-badge">Sub-brand</span>
  <h1>Walk</h1>
  <div class="prose">
    <p>
      Walk is an Android app that supports creative thinking through sound,
      gentle movement, and minimal distraction.
    </p>

    <img
      class="screenshot"
      src="/images/Walk_Screenshot.png"
      alt="Walk's audio selection screen: five generative audio options — Dense Ambient, Noise, Natural Sounds, Near-Silence, and Layered Oscillators — on a plain black background, with a Start Walking button below."
      width="270"
      height="606"
      loading="eager"
    />

    <h2>The design idea</h2>
    <p>
      I deliberately avoided making Walk either a fitness app, meditation app, or 
      productivity tracker. Walk has no goals, no metrics, no social
      features, and no gamification. Unlike any other app on your phone, nothing here is trying to keep you
      coming back.
    </p>
    <p>
      The walking screen is plain black. It's designed to feel make your phone feel
      off even while it's on, to reduce the temptation to look at it. Walk's job is to fade into the background once a walk has started.
    </p>

    <h2>The theory</h2>
    <p>
      Walk is built on a specific body of
      research about how creative thinking actually happens:
    </p>
    <ul>
      {research.map((r) => (
        <li><strong>{r.name}</strong> — {r.note}</li>
      ))}
    </ul>

    <h2>How it works</h2>
    <ul>
      <li>
        Five generative audio modules, built on non-looping algorithms that
        evolve slowly without repetition.
      </li>
      <li>
        Single-tap voice memo capture, for catching a thought without
        breaking stride or fighting an interface.
      </li>
      <li>
        A ten-second pre-walk settling period with a sensory prompt, before
        the walk itself starts.
      </li>
      <li>The walking screen itself: plain, black, minimal.</li>
    </ul>

    <h2>Get Walk</h2>
    <p>
      Walk is live on Google Play: <a href={PLAY_STORE_URL}><strong>play.google.com/store/apps/details?id=com.walk.app</strong></a>
    </p>
  </div>
</Layout>
