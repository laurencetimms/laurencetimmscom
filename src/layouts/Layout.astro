---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Absolute URL. Defaults to the site-wide OG/Twitter portrait. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  description,
  path = '/',
  image = 'https://laurencetimms.com/images/laurence-timms-og.jpg',
  imageAlt = 'Laurence Timms',
  imageWidth = 1200,
  imageHeight = 630,
} = Astro.props;
const siteName = 'Laurence Timms';
const fullTitle = path === '/' ? `${siteName} — Coaching, systems change, and CLAUS` : `${title} — ${siteName}`;

const nav = [
  { href: '/writing/', label: 'Writing' },
  { href: '/coaching/', label: 'Coaching' },
  { href: '/skills/', label: 'Skills' },
  { href: '/claus/', label: 'CLAUS' },
  { href: '/projects/', label: 'Projects' },
];

// Sub-brand and lab pages live under /projects/ but keep their own
// top-level paths; highlight "Projects" when the visitor is on any of them.
const projectPaths = ['/projects/', '/loadedzone/', '/walk/', '/lab/'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://laurencetimms.com${path}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://laurencetimms.com${path}`} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- schema.org: Person, site-wide. Keeps a single canonical machine-readable
         identity statement on every page, per the AI-visibility plan. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Laurence Timms',
      url: 'https://laurencetimms.com',
      image: 'https://laurencetimms.com/images/laurence-timms.webp',
      description:
        'Coach working with leaders and teams through organisational change, software delivery improvement, and AI-augmented coaching practice. Building CLAUS, an open Claude Skills coaching platform.',
      knowsAbout: [
        'Organisational change',
        'Agile coaching',
        'Executive coaching',
        'DORA metrics',
        'Software delivery lifecycle',
        'Claude Skills',
      ],
      sameAs: [],
    })} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/">Laurence Timms</a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item) => {
            const active =
              item.href === '/projects/'
                ? projectPaths.some((p) => path.startsWith(p))
                : path.startsWith(item.href);
            return (
              <a href={item.href} aria-current={active ? 'page' : undefined}>
                {item.label}
              </a>
            );
          })}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>&copy; {new Date().getFullYear()} Laurence Timms</span>
        <span>Built as a static site on Cloudflare Workers</span>
      </footer>
    </div>
  </body>
</html>
