---
import '../styles/global.css';
import { personJsonLd } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Absolute URL. Defaults to the site-wide OG/Twitter portrait. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Use as the full <title>, without the site-name suffix. */
  exactTitle?: string;
  /** Tall sky with the weather phrases and big headline (home page only). */
  hero?: boolean;
  /** 'chalk' (default) = reading surface; 'ground' = dark ground (home). */
  surface?: 'chalk' | 'ground';
}

const {
  title,
  description,
  path = '/',
  image = 'https://laurencetimms.com/images/laurence-timms-og.jpg',
  imageAlt = 'Laurence Timms',
  imageWidth = 1200,
  imageHeight = 630,
  exactTitle,
  hero = false,
  surface = 'chalk',
} = Astro.props;
const siteName = 'Laurence Timms';
const fullTitle = exactTitle ?? (path === '/' ? `${siteName} — Coaching, systems change, and CLAUS` : `${title} — ${siteName}`);

const nav = [
  { href: '/writing/', label: 'Writing', prefixes: ['/writing/'] },
  { href: '/#about', label: 'About', prefixes: [] as string[] },
  { href: '/p100/', label: 'Workshop (P100)', prefixes: ['/p100/'] },
  { href: '/#begin', label: 'Begin', prefixes: [] as string[] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://laurencetimms.com${path}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://laurencetimms.com${path}`} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@200;300;400;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Sky colour follows the visitor's local hour. Runs in <head> so the
         first paint is already the right band (no flash); the server-rendered
         default is midday for crawlers and no-JS visitors. Bands are defined
         in global.css as [data-sky] custom properties. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function band(h) {
          if (h < 5) return 'night';
          if (h < 8) return 'dawn';
          if (h < 11) return 'morning';
          if (h < 15) return 'midday';
          if (h < 17) return 'afternoon';
          if (h < 20) return 'dusk';
          return 'evening';
        }
        function apply() {
          var b = band(new Date().getHours());
          if (root.getAttribute('data-sky') !== b) root.setAttribute('data-sky', b);
        }
        apply();
        setInterval(apply, 60000);
        // Enable the slow transition only after first paint, so the initial
        // band doesn't animate in from midday.
        window.addEventListener('load', function () {
          requestAnimationFrame(function () { root.classList.add('sky-ready'); });
        });
      })();
    </script>

    <!-- schema.org: Person, site-wide. Keeps a single canonical machine-readable
         identity statement on every page, per the AI-visibility plan. -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class={hero ? 'sky sky--hero' : 'sky'}>
      <div class="wrap sky-inner">
        <nav class="site-nav" aria-label="Primary">
          <a class="wordmark" href="/">Laurence Timms</a>
          <span class="links">
            {nav.map((item) => (
              <a
                href={item.href}
                aria-current={item.prefixes.some((p) => path.startsWith(p)) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </span>
        </nav>
        <slot name="sky" />
      </div>
    </header>
    <div class="horizon-line"></div>
    <slot name="band" />
    <main id="main" class={surface === 'ground' ? 'ground' : 'chalk'}>
      <div class={surface === 'ground' ? 'wrap ground-inner' : 'wrap chalk-inner'}>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot">
          <span>&copy; {new Date().getFullYear()} Laurence Timms · <a href="/ai/">How AI is used on this site</a></span>
          <a href="/p100/">Also: the workshop &rarr;</a>
        </div>
      </div>
    </footer>
  </body>
</html>
